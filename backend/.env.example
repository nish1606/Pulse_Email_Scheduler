# Backend
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://pulse:pulse_dev_password@localhost:5432/pulse_email_scheduler?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Worker/rate limiting (Phase 3; defaults shown)
WORKER_CONCURRENCY=5
# Global/env fallback: minimum delay between emails (ms). Batch requests may persist sendDelayMs per email.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global/env fallback: max emails per sender per UTC hour. Sender.hourlyLimit overrides when set.
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Ethereal SMTP (Milestone 2) - fill from https://ethereal.email/create
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=
ETHEREAL_SMTP_PASS=

# Google OAuth (Milestone 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
SESSION_SECRET=change_me_in_local_dev

# Bull Board (protected admin UI)
BULL_BOARD_USER=pulse_admin
BULL_BOARD_PASS=change_me_locally

# Slack OAuth (Milestone 5) + rate-limit notifications
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
# Default channel for Slack notifications when SlackAccount.channelId is not set (e.g., C0123456789)
SLACK_DEFAULT_CHANNEL_ID=
